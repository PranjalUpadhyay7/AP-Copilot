# NVIDIA NIM (or any OpenAI-compatible chat endpoint). Get a key at https://build.nvidia.com/
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NIM_REQUEST_TIMEOUT_S=60
# NIM_MAX_RETRIES=1

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ap-copilot

# Local ArduPilot checkout, used for the built-in simulator (default: ~/ardupilot)
# ARDUPILOT_ROOT=
# Where sessions, caches and indexes are stored (default: ~/.ap-copilot)
# AP_COPILOT_HOME=

# Index the ArduPilot wiki (needs network and ~2 GB of disk the first time)
# AP_COPILOT_WIKI_SYNC=1
# Let the assistant search ardupilot.org when the docs come up empty
# AP_COPILOT_WEB_SEARCH=1
